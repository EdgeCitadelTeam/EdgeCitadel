{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.dev/schemas/trace-effect-request.v1.json",
  "title": "effect.authorize request v1",
  "description": "Asked by a harness before one external effect of a bound invocation. The target is exact: a path, command, URL or device as the harness classifies it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "binding_id",
    "effect_class",
    "target",
    "tool_call_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "effect_class": {
      "enum": [
        "fs.write",
        "process.exec",
        "network.http",
        "device.command"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*[\\r\\n])[^\\u0000-\\u001f\\u007f]*[^\\u0000-\\u001f\\u007f*]$"
    },
    "tool_call_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[\\r\\n])[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scheduled_at_ms": {
      "description": "When set in the future, the effect is checked and requested now and must be committed with effect.commit.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
