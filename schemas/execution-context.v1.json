{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.dev/schemas/execution-context.v1.json",
  "title": "Optional v1 payload execution context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_origin",
    "parent_run_id",
    "authority_scope",
    "effect_scope",
    "lease",
    "authority_chain"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "context_origin": {
      "enum": [
        "source_explicit",
        "legacy_default"
      ]
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_scope": {
      "description": "Recipients the delegating invocation could reach; a child can only narrow it. Null only for root tasks.",
      "anyOf": [
        {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "effect_scope": {
      "description": "Effect rules the delegating invocation could authorize; a child can only narrow them. A target ending in * is a prefix. Null only for root tasks.",
      "anyOf": [
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effect_class",
              "target"
            ],
            "properties": {
              "effect_class": {
                "enum": [
                  "fs.write",
                  "process.exec",
                  "network.http",
                  "device.command"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!.*[\\r\\n])[^\\u0000-\\u001f\\u007f]+$"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "lease": {
      "description": "Hard limits of the delegated task, within the delegator's remainder. Null means unlimited. max_tokens is carried but not metered.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expires_at_ms",
            "max_effects",
            "max_tokens"
          ],
          "properties": {
            "expires_at_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_effects": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_chain": {
      "description": "Delegated task IDs from the root to the parent; revocations and ingress filters naming any of them apply to this task.",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    }
  }
}
