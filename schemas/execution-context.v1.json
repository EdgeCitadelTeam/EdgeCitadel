{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.dev/schemas/execution-context.v1.json",
  "title": "Optional v1 payload execution context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_origin",
    "parent_run_id",
    "authority_scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "context_origin": {
      "enum": [
        "source_explicit",
        "legacy_default"
      ]
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_scope": {
      "description": "Recipients the delegating invocation could reach; a child can only narrow it. Null only for root tasks.",
      "anyOf": [
        {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$(?![\\s\\S])"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
