{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.dev/schemas/trace-append-request.v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "binding_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "observation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "enum": [
            "model",
            "tool"
          ]
        },
        "phase": {
          "type": "string"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?!.*[\\r\\n])[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "phase",
        "span_id",
        "parent_span_id",
        "occurred_at",
        "duration_ms",
        "attributes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "model"
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "started",
                  "finished",
                  "failed",
                  "interrupted"
                ]
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^(?!.*[\\r\\n])[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
                  },
                  "input_tokens": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_tokens": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "usage_unavailable_reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "not_reported",
                          "unsupported",
                          "interrupted"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "permission_denied",
                          "session_unavailable",
                          "session_closed",
                          "connector_revoked",
                          "deadline_expired",
                          "handler_failed",
                          "transport_unavailable",
                          "invalid_linkage",
                          "unsupported_version",
                          "retention_expired",
                          "quota_exceeded",
                          "unknown"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "input_tokens",
                  "output_tokens",
                  "usage_unavailable_reason"
                ],
                "additionalProperties": false
              },
              "trace_id": {
                "type": "string",
                "pattern": "^(?!.*[\\r\\n])[0-9a-f]{32}$"
              },
              "span_id": {
                "type": "string",
                "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "started",
                  "finished",
                  "failed",
                  "interrupted"
                ]
              },
              "attributes": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^(?!.*[\\r\\n])[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "permission_denied",
                          "session_unavailable",
                          "session_closed",
                          "connector_revoked",
                          "deadline_expired",
                          "handler_failed",
                          "transport_unavailable",
                          "invalid_linkage",
                          "unsupported_version",
                          "retention_expired",
                          "quota_exceeded",
                          "unknown"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "content_available": {
                    "type": "boolean"
                  },
                  "local_content_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "trace_id": {
                "type": "string",
                "pattern": "^(?!.*[\\r\\n])[0-9a-f]{32}$"
              },
              "span_id": {
                "type": "string",
                "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "binding_id",
    "observation_id",
    "observation"
  ],
  "additionalProperties": false
}
