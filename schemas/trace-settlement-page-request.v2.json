{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.dev/schemas/trace-settlement-page-request.v2.json",
  "title": "Settlement page request v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "node_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "export_generation": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "after_export_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "collector_epoch": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "source_epoch",
    "export_generation",
    "request_id",
    "after_export_seq",
    "collector_epoch"
  ],
  "additionalProperties": false
}
