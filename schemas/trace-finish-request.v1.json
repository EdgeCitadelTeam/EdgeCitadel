{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.dev/schemas/trace-finish-request.v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "outcome": {
      "enum": [
        "completed",
        "failed",
        "canceled",
        "unknown"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "permission_denied",
            "session_unavailable",
            "session_closed",
            "connector_revoked",
            "deadline_expired",
            "handler_failed",
            "transport_unavailable",
            "invalid_linkage",
            "unsupported_version",
            "retention_expired",
            "quota_exceeded",
            "unknown"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "binding_id",
    "outcome",
    "reason"
  ],
  "additionalProperties": false
}
