{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.dev/schemas/trace-export.v1.json",
  "title": "Trace selected export v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "node_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "export_generation": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "export_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{64}$"
    },
    "event": {
      "$ref": "https://edgecitadel.dev/schemas/trace-event.v1.json"
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "source_epoch",
    "export_generation",
    "export_seq",
    "event_sha256",
    "event"
  ],
  "additionalProperties": false
}
