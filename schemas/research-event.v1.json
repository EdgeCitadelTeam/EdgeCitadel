{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.dev/schemas/research-event.v1.json",
  "title": "EdgeCitadel Research Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "trial_id", "sequence", "monotonic_ns", "epoch_time", "component", "event", "data"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "epoch_time": {"type": "string", "format": "date-time"},
    "component": {"type": "string", "minLength": 1},
    "event": {"type": "string", "minLength": 1},
    "data": {"type": "object"}
  }
}
