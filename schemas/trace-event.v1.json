    "event_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "agent_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[a-z0-9][a-z0-9_-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
