    "attributes": {
      "type": "object"
    },
    "supersedes_event_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
