{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.dev/schemas/trace-capability.v1.json",
  "type": "object",
  "required": [
    "uri",
    "params"
  ],
  "properties": {
    "uri": {
      "const": "https://edgecitadel.dev/extensions/execution-trace"
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "required": {
      "const": false
    },
    "params": {
      "type": "object",
      "required": [
        "schema_versions",
        "families"
      ],
      "properties": {
        "schema_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "families": {
          "type": "object",
          "properties": {
            "run": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            },
            "task": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            },
            "dispatch": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            },
            "permission": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            },
            "model": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            },
            "tool": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            },
            "coverage": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            },
            "source": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            },
            "link": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            },
            "security": {
              "enum": [
                "live",
                "historical",
                "unsupported"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
