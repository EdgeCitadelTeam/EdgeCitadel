{
  "mode": "lab",
  "system": "a2a",
  "_note": "Google A2A baseline on the lab: kipp on jim-eq, teams T and C on Endurance (Cluster unused). Ports from the A2A design note: agent servers 19300 + agent index, services 19390; listeners on each host's tailnet address.",
  "controller": "jim-eq",
  "hosts": {
    "jim-eq": {
      "address": "${HARNESS_JIM_ADDRESS}",
      "python": "${HARNESS_PYTHON}",
      "repo": "${HARNESS_REPO}",
      "runtime_root": "${HARNESS_RUNTIME_ROOT}",
      "work_root": "${HARNESS_WORK_ROOT}"
    },
    "netsys-endurance": {
      "ssh": "${HARNESS_SSH_ENDURANCE}",
      "address": "${HARNESS_ENDURANCE_ADDRESS}",
      "python": "${HARNESS_REMOTE_PYTHON}",
      "repo": "${HARNESS_REMOTE_REPO}",
      "runtime_root": "${HARNESS_REMOTE_RUNTIME_ROOT}",
      "work_root": "${HARNESS_REMOTE_WORK_ROOT}"
    }
  },
  "node_hosts": {
    "core": "jim-eq",
    "edge-1": "netsys-endurance",
    "edge-2": "netsys-endurance"
  },
  "ports": {
    "services": 19390,
    "a2a_base": 19300
  },
  "effect_sink": {
    "kind": "ledger"
  },
  "procstat_interval_ms": 200
}
