{
  "mode": "lab",
  "controller": "jim-eq",
  "control_transport": "nats",
  "_note": "scale testbed: up to 32 agentd sites; core (the root's team) with Core, NATS, the services and the monitor on jim-eq, every other site on NetSys-Endurance. Own ports, unit prefix and work roots, so it never collides with the evaluation stack; do not run both at once (shared CPUs would confound both measurements).",
  "hosts": {
    "jim-eq": {
      "address": "${HARNESS_JIM_ADDRESS}",
      "listen": "${HARNESS_CONTROLLER_LISTEN}",
      "python": "${HARNESS_PYTHON}",
      "repo": "${HARNESS_REPO}",
      "runtime_root": "${HARNESS_RUNTIME_ROOT}",
      "work_root": "${HARNESS_WORK_ROOT}",
      "nats_server": "${HARNESS_NATS_SERVER}"
    },
    "netsys-endurance": {
      "ssh": "${HARNESS_SSH_ENDURANCE}",
      "units": "user",
      "unit_prefix": "firebreak-exp-s-",
      "address": "${HARNESS_ENDURANCE_ADDRESS}",
      "python": "${HARNESS_REMOTE_PYTHON}",
      "repo": "${HARNESS_REMOTE_REPO}",
      "runtime_root": "${HARNESS_REMOTE_RUNTIME_ROOT}",
      "work_root": "${HARNESS_REMOTE_WORK_ROOT}"
    }
  },
  "node_hosts": {
    "core": "jim-eq",
    "edge-1": "netsys-endurance",
    "edge-2": "netsys-endurance",
    "edge-3": "netsys-endurance",
    "edge-4": "netsys-endurance",
    "edge-5": "netsys-endurance",
    "edge-6": "netsys-endurance",
    "edge-7": "netsys-endurance",
    "edge-8": "netsys-endurance",
    "edge-9": "netsys-endurance",
    "edge-10": "netsys-endurance",
    "edge-11": "netsys-endurance",
    "edge-12": "netsys-endurance",
    "edge-13": "netsys-endurance",
    "edge-14": "netsys-endurance",
    "edge-15": "netsys-endurance",
    "edge-16": "netsys-endurance",
    "edge-17": "netsys-endurance",
    "edge-18": "netsys-endurance",
    "edge-19": "netsys-endurance",
    "edge-20": "netsys-endurance",
    "edge-21": "netsys-endurance",
    "edge-22": "netsys-endurance",
    "edge-23": "netsys-endurance",
    "edge-24": "netsys-endurance",
    "edge-25": "netsys-endurance",
    "edge-26": "netsys-endurance",
    "edge-27": "netsys-endurance",
    "edge-28": "netsys-endurance",
    "edge-29": "netsys-endurance",
    "edge-30": "netsys-endurance",
    "edge-31": "netsys-endurance"
  },
  "ports": {
    "nats": 24322,
    "nats_monitor": 28322,
    "services": 28900,
    "aggregator": 28800
  },
  "tau_ms": 50,
  "effect_sink": {
    "kind": "ledger"
  },
  "controller_lease_ms": 30000,
  "runtime_env": {
    "EDGECITADEL_TRANSPORT_POLL_MS": "1000",
    "EDGECITADEL_CLAIM_POLL_MS": "1000"
  },
  "procstat_interval_ms": 1000
}
