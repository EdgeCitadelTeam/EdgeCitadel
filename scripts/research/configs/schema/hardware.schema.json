{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "architecture", "os", "cpu_cores", "memory_bytes", "cgroup_limits", "clock_source"],
  "properties": {
    "profile": {"type": "string", "minLength": 1},
    "architecture": {"enum": ["x86_64", "aarch64"]},
    "os": {"const": "ubuntu-24.04"},
    "cpu_cores": {"type": "integer", "minimum": 1},
    "memory_bytes": {"type": "integer", "minimum": 1},
    "cgroup_limits": {"type": "object", "required": ["cpu", "memory_bytes"]},
    "clock_source": {"const": "perf_counter_ns"}
  }
}
