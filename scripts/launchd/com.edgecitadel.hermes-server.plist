<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edgecitadel.hermes-server</string>

  <!-- Note: prefer `hermes gateway install` to register the official Hermes
       launchd unit, which manages all enabled platforms (incl. API Server on
       :8642). This plist is provided for operators who want EdgeCitadel-owned
       lifecycle management of the gateway alongside the bridge adapter. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>HERMES_HOME=/Users/yefanzhang/.hermes</string>
    <string>/Users/yefanzhang/.local/bin/hermes</string>
    <string>gateway</string>
    <string>run</string>
  </array>

  <key>StandardOutPath</key>
  <string>/var/log/edgecitadel/hermes-server.log</string>

  <key>StandardErrorPath</key>
  <string>/var/log/edgecitadel/hermes-server.err</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
