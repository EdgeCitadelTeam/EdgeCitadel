<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edgecitadel.hermes-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/hermes</string>
    <string>serve</string>
    <string>--port</string>
    <string>8642</string>
  </array>

  <key>StandardOutPath</key>
  <string>/var/log/edgecitadel/hermes-server.log</string>

  <key>StandardErrorPath</key>
  <string>/var/log/edgecitadel/hermes-server.err</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
