<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edgecitadel.hermes-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>-m</string>
    <string>adapters.hermes.adapter</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/opt/edge-research</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/opt/edge-research</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/var/log/edgecitadel/hermes-bridge.log</string>

  <key>StandardErrorPath</key>
  <string>/var/log/edgecitadel/hermes-bridge.err</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
