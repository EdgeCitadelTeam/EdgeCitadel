NATS_TOKEN=change-me
NATS_LEAF_USERNAME=change-me-leaf-user
NATS_LEAF_PASSWORD=change-me-leaf-password
# Administrator credential for enrollment and Core telemetry lifecycle control.
EDGECITADEL_ADMIN_TOKEN=change-me-admin
# Set EC_ENABLE_MQTT=1 before running scripts/render-nats-conf.sh to
# enable deploy-time MQTT ingress. Default off.
# Managed `create` records the initial EC_ENABLE_MQTT environment choice in its
# saved access policy. Reruns preserve that choice and reject conflicting exports.
# Raw docker compose bypasses the CLI's saved local/Tailscale/custom port policy.
EC_ENABLE_MQTT=0
# NATS has a 2GiB file-storage budget: the agent inbox reserves 1GiB, leaving
# capacity for telemetry (128MiB when enabled) and optional MQTT streams.
# Storage limits are versioned in nats/nats.conf.tpl; regenerate the checked-in
# config with scripts/render-nats-conf.sh before using raw Docker Compose.

# Experimental source telemetry synchronization: export this in the agentd process
# environment (agentd does not load this file). Default off; M4 fault/capacity
# acceptance is still under development.
EDGECITADEL_TRACE_SYNC=0
# Experimental Core collector; raw Compose forwards this to the Aggregator.
EDGECITADEL_TRACE_COLLECTOR=0
# Experimental fleet-wide trace reads/projector; requires collector=1.
EDGECITADEL_TRACE_READS=0
# Set a separate secrets.token_urlsafe(32) credential before enabling reads.
EDGECITADEL_TRACE_READ_TOKEN=
# JSON array of exact dashboard origins; [] permits only clients without Origin.
EDGECITADEL_TRACE_ORIGINS=[]

# Gemma Agent Package. See agent-packages/gemma/README.md.
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
# Default: gemma4:e2b (smallest "efficient" variant, ~2B params).
# To switch, set OLLAMA_MODEL to one of:
#   gemma4:e2b   — efficient 2B (default; lowest VRAM, fastest)
#   gemma4:e4b   — efficient 4B (better reasoning, ~2× memory)
#   gemma4:26b   — full 26B (Mac Mini-class hosts only)
#   gemma4:31b   — full 31B (workstation/A100-class)
# Pull first:  ollama pull <tag>
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SEC=120

# Phase 2.5 conversational memory (aggregator-owned SQLite + NATS API)
# Override only for tests / staging. Default 30 days = 2592000 seconds.
# MEMORY_RETENTION_SEC=2592000

# Optional agentd-only disposable test provenance. Set a UUIDv4 before an isolated
# source emits its first trace. Never enable this globally for real user work.
# EDGECITADEL_TRACE_TEST_RUN_ID=
