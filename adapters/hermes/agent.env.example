# Hermes bridge adapter environment template.
# Copy to agent.env and fill in NATS_TOKEN + HERMES_TOKEN.

# --- NATS connection (from add-agent.sh on the aggregator host) ---
NATS_URL=nats://<broker-host>:4222
NATS_TOKEN=<from .env on aggregator host>

# --- Hermes Agent (running locally on this Mac) ---
# Default: hermes serve --port 8642
HERMES_BASE_URL=http://localhost:8642
# Bearer token printed by `hermes serve` on startup (or set via `hermes config token`)
HERMES_TOKEN=<bearer token>
# Display label only; does NOT control which model Hermes uses (that's `hermes model`)
HERMES_MODEL=hermes
HERMES_TIMEOUT_SEC=300

# --- Optional ---
LOG_LEVEL=INFO
ACK_WAIT_SEC=300
