# EdgeCitadel Agent Configuration
# Copy to agent.env and fill in values.
# Never commit agent.env -- it contains secrets.

# -- Agent Identity --
AGENT_ID=""                    # lowercase, no spaces (e.g. us-claw-remote)
AGENT_DISPLAY=""               # human-readable name (e.g. US Claw Remote)
AGENT_ROLE=""                  # role shown on dashboard (e.g. Assistant, IoT Controller)
AGENT_DEVICE_TYPE=""           # server, raspberry_pi, smartphone, etc.

# -- EdgeCitadel MQTT Broker --
CITADEL_HOST=""                # IP or hostname of EdgeCitadel server
CITADEL_PORT=1883              # MQTT port (default 1883)
MQTT_USER=""                   # MQTT username (ask EdgeCitadel admin)
MQTT_PASS=""                   # MQTT password (ask EdgeCitadel admin)

# -- Local OpenClaw Gateway --
GATEWAY_URL="http://127.0.0.1:18789"   # local gateway endpoint
WAKE_MODE="api"                         # 'api' (chat completions) or 'webhook' (/hooks/wake)
GATEWAY_TOKEN=""                        # Bearer token for gateway auth

# -- Heartbeat --
HEARTBEAT_SEC=30               # how often to send health metrics (seconds)
