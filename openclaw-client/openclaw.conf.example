# openclaw.conf.example
# Copy to openclaw.conf and fill in values.
# Never commit openclaw.conf -- add it to .gitignore.

# -- Identity ---------------------------------------------------------------
DEPLOYMENT_NAME=""          # unique name e.g. "home", "office", "pi-rack"
DEPLOYMENT_HOST=""          # the address aggregators use to reach THIS NATS server
                            # e.g. Tailscale: oc-home.your-tailnet.ts.net
                            #      LAN:       192.168.1.42
                            #      Public:    203.0.113.10
DEPLOYMENT_PORT=4222
DEPLOYMENT_DESCRIPTION=""

# -- Aggregators -------------------------------------------------------------
# Space-separated array of "name=url" pairs.
# This deployment will register/deregister with each listed aggregator.
AGGREGATORS=(
    # "edge-citadel=https://edge-citadel-us"
    # "home-dashboard=http://192.168.1.100:8080"
)

# -- API Keys ----------------------------------------------------------------
# One variable per aggregator.
# Naming convention: API_KEY_<AGGREGATOR_NAME_UPPERCASE_UNDERSCORED>
# e.g. for "edge-citadel"  -> API_KEY_EDGE_CITADEL
# e.g. for "home-dashboard" -> API_KEY_HOME_DASHBOARD
#
# API_KEY_EDGE_CITADEL=""
# API_KEY_HOME_DASHBOARD=""
