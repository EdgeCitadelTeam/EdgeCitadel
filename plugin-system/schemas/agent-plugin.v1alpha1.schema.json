{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecitadel.io/schemas/agent-plugin.v1alpha1.schema.json",
  "title": "EdgeCitadel Agent Plugin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "compatibility",
    "runtime",
    "skills",
    "agents",
    "permissions",
    "security",
    "extensions"
  ],
  "properties": {
    "apiVersion": {
      "const": "edgecitadel.io/v1alpha1"
    },
    "kind": {
      "const": "AgentPlugin"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "description", "version", "publisher"],
      "properties": {
        "name": {
          "$ref": "#/$defs/normalizedName"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "publisher": {
          "$ref": "#/$defs/normalizedName"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supervisorApi", "protocols"],
      "properties": {
        "supervisorApi": {
          "type": "string",
          "minLength": 1
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "healthTimeoutSeconds", "restartPolicy"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "healthTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "restartPolicy": {
          "enum": ["always", "on-failure", "never"]
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skillNames", "listensBroadcast"],
        "properties": {
          "id": {
            "$ref": "#/$defs/agentId"
          },
          "skillNames": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/normalizedName"
            }
          },
          "listensBroadcast": {
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "messaging", "network", "devices"],
      "properties": {
        "knowledge": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "messaging": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outboundAgents"],
          "properties": {
            "outboundAgents": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/agentId"
              }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outbound"],
          "properties": {
            "outbound": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "devices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "secrets"],
      "properties": {
        "sandbox": {
          "enum": ["restricted", "unrestricted"]
        },
        "secrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensionMap"
    }
  },
  "$defs": {
    "normalizedName": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*?/\\.\\.?(?:/|$))(?:[^/]+/)*[^/]+$"
    },
    "extensionMap": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
          },
          {
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:(?:[A-Za-z0-9._~!$&'()*+,;=:@/?#-]|%[0-9A-Fa-f]{2})+$"
          }
        ]
      },
      "additionalProperties": true
    },
    "agentId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    }
  }
}
