[Unit]
Description=EdgeCitadel — Ollama runtime (Phase 5)
Documentation=https://github.com/ollama/ollama
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgecitadel
Group=edgecitadel

Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_MODELS=/var/lib/edgecitadel/ollama"
Environment="OLLAMA_KEEP_ALIVE=24h"
# ollama daemon writes id_ed25519 (client identity for ollama registry) to
# $HOME/.ollama. With ProtectHome=true, /home/edgecitadel is inaccessible
# in the unit's mount namespace. Redirect HOME to /var/lib/edgecitadel
# (already in ReadWritePaths).
Environment="HOME=/var/lib/edgecitadel"

ExecStart=/usr/local/bin/ollama serve

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening — see ADR-0009 for rationale.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# /var/lib/edgecitadel is the parent of both ollama models AND the .ollama
# id_ed25519 store (HOME above). One ReadWritePaths covers both.
ReadWritePaths=/var/lib/edgecitadel /var/log/edgecitadel
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=

# Ollama uses CPU heavily; allow normal I/O scheduling.
IOSchedulingClass=best-effort
Nice=0

# Memory limits — prevents Ollama OOM'ing other host services.
# N150 box has 16GB total; leave headroom for docker stack + system.
MemoryMax=6G
MemoryHigh=5G

[Install]
WantedBy=multi-user.target
