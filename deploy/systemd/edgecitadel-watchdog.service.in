[Unit]
Description=EdgeCitadel — fleet watchdog adapter (Phase 5, Phase 3.1 spec)
Documentation=file:///opt/edgecitadel/adapters/watchdog/README.md
After=network-online.target docker.service
Wants=network-online.target
# No dependency on Ollama — watchdog is broker-only.

[Service]
Type=simple
User=edgecitadel
Group=edgecitadel
WorkingDirectory=/opt/edgecitadel

EnvironmentFile=/etc/edgecitadel/env
Environment="NATS_URL=nats://localhost:4222"
Environment="PYTHONUNBUFFERED=1"

ExecStart=/var/lib/edgecitadel/venvs/watchdog/bin/python -m adapters.watchdog.adapter

Restart=on-failure
RestartSec=10
TimeoutStopSec=15

# Same hardening stanza as gemma, slightly tighter — no Ollama HTTP call.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/edgecitadel
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @raw-io @reboot @swap @cpu-emulation @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

MemoryMax=128M
MemoryHigh=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
