[Unit]
Description=EdgeCitadel — Gemma Plugin runtime (Phase 5)
Documentation=file:///opt/edgecitadel/plugins/gemma/README.md
After=network-online.target edgecitadel-ollama.service docker.service
# Wants (not Requires) — gemma can survive ollama-restart and retries
# the Ollama HTTP call internally.
Wants=network-online.target edgecitadel-ollama.service

[Service]
Type=simple
User=edgecitadel
Group=edgecitadel
WorkingDirectory=/opt/edgecitadel/plugins/gemma

EnvironmentFile=/etc/edgecitadel/env
Environment="NATS_URL=nats://localhost:4222"
Environment="OLLAMA_HOST=localhost"
Environment="OLLAMA_PORT=11434"
Environment="OLLAMA_MODEL=gemma4:e2b"
Environment="OLLAMA_TIMEOUT_SEC=120"
Environment="PYTHONUNBUFFERED=1"

ExecStart=/var/lib/edgecitadel/venvs/gemma/bin/python -m edgecitadel_gemma_plugin

Restart=on-failure
RestartSec=10
TimeoutStopSec=20

# Hardening — stricter than Ollama (no native code, just Python over HTTP+NATS).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/edgecitadel
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @raw-io @reboot @swap @cpu-emulation @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource caps
MemoryMax=512M
MemoryHigh=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
